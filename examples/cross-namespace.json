{
  "scenario": {
    "namespaces": [
      { "name": "frontend", "labels": { "tier": "frontend" } },
      { "name": "backend", "labels": { "tier": "backend" } }
    ],
    "pods": [
      {
        "namespace": "frontend",
        "name": "web",
        "labels": { "app": "web" },
        "ip": "10.10.1.10"
      },
      {
        "namespace": "backend",
        "name": "api-a",
        "labels": { "app": "api" },
        "ip": "10.20.0.11",
        "ports": [{ "name": "http", "containerPort": 8080, "protocol": "TCP" }]
      },
      {
        "namespace": "backend",
        "name": "api-b",
        "labels": { "app": "api" },
        "ip": "10.20.0.12",
        "ports": [{ "name": "http", "containerPort": 8080, "protocol": "TCP" }]
      }
    ],
    "services": [
      {
        "namespace": "backend",
        "name": "api",
        "selector": { "app": "api" },
        "clusterIP": "172.16.0.100",
        "ports": [{ "name": "http", "port": 80, "targetPort": "http", "protocol": "TCP" }]
      }
    ],
    "policies": [
      {
        "namespace": "frontend",
        "name": "web-egress",
        "podSelector": { "matchLabels": { "app": "web" } },
        "policyTypes": ["Egress"],
        "egress": [
          {
            "to": [
              {
                "namespaceSelector": { "matchLabels": { "tier": "backend" } },
                "podSelector": { "matchLabels": { "app": "api" } }
              }
            ],
            "ports": [{ "port": 8080, "protocol": "TCP" }]
          }
        ]
      },
      {
        "namespace": "backend",
        "name": "api-ingress",
        "podSelector": { "matchLabels": { "app": "api" } },
        "policyTypes": ["Ingress"],
        "ingress": [
          {
            "from": [{ "namespaceSelector": { "matchLabels": { "tier": "frontend" } } }],
            "ports": [{ "port": 8080, "protocol": "TCP" }]
          }
        ]
      }
    ]
  },
  "request": {
    "sourceNamespace": "frontend",
    "sourcePod": "web",
    "destinationService": { "namespace": "backend", "name": "api" },
    "destinationPort": 80,
    "protocol": "TCP"
  }
}
